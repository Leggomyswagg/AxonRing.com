  <style>
    /* ── Reset ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ink: #0C0A08;
      --ink-2: #161210;
      --ink-3: #1E1A16;
      --gold: #C9A84C;
      --gold-light: #E8C97A;
      --gold-pale: #F5E6C0;
      --gold-dim: rgba(201,168,76,0.15);
      --cream: #FAF7F0;
      --warm-white: #F2EDE4;
      --stone: #8C7B6B;
      --stone-light: #B5A898;
      --border: rgba(201,168,76,0.18);
      --border-soft: rgba(201,168,76,0.08);
      --ff-serif: 'Cormorant Garamond', 'Georgia', serif;
      --ff-serif-bold: 'Cormorant', 'Georgia', serif;
      --ff-sans: 'Jost', sans-serif;
    }

    html { scroll-behavior: smooth; }
    body {
      font-family: var(--ff-sans); background: var(--ink); color: var(--cream);
      overflow-x: hidden; font-weight: 300; letter-spacing: 0.02em;
      cursor: none;
    }

    /* ── Custom cursor ── */
    .cursor {
      position: fixed; width: 8px; height: 8px; border-radius: 50%;
      background: var(--gold); pointer-events: none; z-index: 9999;
      transform: translate(-50%,-50%); transition: transform 0.1s;
    }
    .cursor-ring {
      position: fixed; width: 36px; height: 36px; border-radius: 50%;
      border: 1px solid rgba(201,168,76,0.4); pointer-events: none; z-index: 9998;
      transform: translate(-50%,-50%); transition: all 0.15s ease;
    }
    body:hover .cursor { opacity: 1; }

    /* ── Grain overlay ── */
    body::after {
      content: '';
      position: fixed; inset: 0; z-index: 9990; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='grain'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23grain)' opacity='0.05'/%3E%3C/svg%3E");
      opacity: 0.35; mix-blend-mode: overlay;
    }

    /* ── NAV ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 56px; height: 80px;
      border-bottom: 1px solid transparent;
      transition: border-color 0.4s, background 0.4s;
    }
    nav.scrolled {
      background: rgba(12,10,8,0.94);
      backdrop-filter: blur(24px);
      border-color: var(--border-soft);
    }
    .nav-wordmark {
      font-family: var(--ff-serif-bold); font-size: 22px; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase; color: var(--cream);
    }
    .nav-wordmark span { color: var(--gold); }
    .nav-links {
      display: flex; align-items: center; gap: 40px;
      font-size: 11px; font-weight: 400; letter-spacing: 0.2em; text-transform: uppercase;
    }
    .nav-links a { color: var(--stone-light); transition: color 0.2s; }
    .nav-links a:hover { color: var(--gold-light); }
    .nav-acquire {
      font-size: 11px; font-weight: 400; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--gold); border: 1px solid var(--border); padding: 10px 24px;
      transition: background 0.3s, color 0.3s;
    }
    .nav-acquire:hover { background: var(--gold); color: var(--ink); }
    .nav-mobile-btn { display: none; background: none; border: none; cursor: none; padding: 4px; }
    .nav-mobile-btn span { display: block; width: 20px; height: 1px; background: var(--stone-light); margin: 5px 0; transition: all 0.3s; }

    /* ── HERO ── */
    .hero {
      min-height: 100vh; display: grid; place-items: center;
      text-align: center; padding: 140px 40px 100px;
      background:
        radial-gradient(ellipse 60% 50% at 50% -10%, rgba(201,168,76,0.08) 0%, transparent 70%),
        radial-gradient(ellipse 40% 60% at 20% 80%, rgba(201,168,76,0.04) 0%, transparent 60%);
      position: relative; overflow: hidden;
    }
    .hero-inner { max-width: 900px; margin: 0 auto; }
    .hero-kicker {
      font-size: 10px; letter-spacing: 0.4em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 48px; display: block;
      animation: fade-down 1s ease 0.2s both;
    }
    .hero-title {
      font-family: var(--ff-serif); font-size: clamp(52px, 9vw, 110px);
      font-weight: 300; line-height: 1.0; letter-spacing: -0.01em;
      margin-bottom: 40px; color: var(--cream);
      animation: fade-down 1s ease 0.4s both;
    }
    .hero-title em { font-style: italic; color: var(--gold-light); }
    .hero-divider {
      width: 1px; height: 80px; background: linear-gradient(to bottom, transparent, var(--gold), transparent);
      margin: 0 auto 40px;
      animation: fade-in 1s ease 0.6s both;
    }
    .hero-sub {
      font-size: 14px; letter-spacing: 0.12em; line-height: 2;
      color: var(--stone-light); max-width: 480px; margin: 0 auto 56px;
      animation: fade-in 1s ease 0.7s both;
    }
    .hero-ctas {
      display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;
      animation: fade-up 1s ease 0.9s both;
    }
    .btn-gold {
      display: inline-block; padding: 16px 44px;
      background: var(--gold); color: var(--ink);
      font-size: 11px; font-weight: 500; letter-spacing: 0.25em; text-transform: uppercase;
      transition: background 0.3s, transform 0.2s;
    }
    .btn-gold:hover { background: var(--gold-light); transform: translateY(-1px); }
    .btn-ghost {
      display: inline-block; padding: 16px 44px;
      border: 1px solid var(--border); color: var(--stone-light);
      font-size: 11px; font-weight: 400; letter-spacing: 0.25em; text-transform: uppercase;
      transition: border-color 0.3s, color 0.3s;
    }
    .btn-ghost:hover { border-color: var(--gold); color: var(--gold-light); }

    /* ── Ring sculpture hero ── */
    .ring-sculpture {
      width: 280px; height: 280px; margin: 0 auto 56px;
      position: relative; display: flex; align-items: center; justify-content: center;
      animation: fade-in 1.4s ease 0.5s both;
    }
    .rs-track {
      position: absolute; border-radius: 50%; border: 1px solid;
    }
    .rs-track-1 { inset: 0; border-color: rgba(201,168,76,0.08); animation: spin-cw 30s linear infinite; }
    .rs-track-2 { inset: 20px; border-color: rgba(201,168,76,0.12); animation: spin-ccw 20s linear infinite; }
    .rs-track-3 { inset: 40px; border-color: rgba(201,168,76,0.06); animation: spin-cw 40s linear infinite; }
    .rs-node {
      position: absolute; width: 5px; height: 5px; border-radius: 50%;
      background: var(--gold); box-shadow: 0 0 8px var(--gold);
    }
    .rs-node-1 { top: -2px; left: calc(50% - 2px); }
    .rs-node-2 { bottom: -2px; left: calc(50% - 2px); }
    @keyframes spin-cw { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
    @keyframes spin-ccw { from{transform:rotate(0deg)} to{transform:rotate(-360deg)} }
    .rs-ring {
      width: 160px; height: 160px; border-radius: 50%;
      border: 20px solid var(--gold);
      box-shadow:
        0 0 0 1px rgba(201,168,76,0.2),
        0 0 40px rgba(201,168,76,0.15),
        0 0 80px rgba(201,168,76,0.06),
        inset 0 2px 4px rgba(255,255,255,0.1),
        inset 0 -2px 4px rgba(0,0,0,0.3);
      animation: ring-breathe 5s ease-in-out infinite;
      display: flex; align-items: center; justify-content: center;
    }
    @keyframes ring-breathe {
      0%,100% { box-shadow: 0 0 0 1px rgba(201,168,76,0.2), 0 0 40px rgba(201,168,76,0.15), 0 0 80px rgba(201,168,76,0.06); }
      50% { box-shadow: 0 0 0 1px rgba(201,168,76,0.3), 0 0 60px rgba(201,168,76,0.25), 0 0 120px rgba(201,168,76,0.1); }
    }
    .rs-inner { width: 100px; height: 100px; border-radius: 50%; border: 1px solid rgba(201,168,76,0.2); }

    /* ── Manifesto ── */
    .manifesto {
      padding: 140px 40px;
      background: var(--ink-2);
      border-top: 1px solid var(--border-soft);
      border-bottom: 1px solid var(--border-soft);
    }
    .manifesto-inner { max-width: 760px; margin: 0 auto; text-align: center; }
    .manifesto-quote {
      font-family: var(--ff-serif); font-size: clamp(28px, 4vw, 48px);
      font-weight: 300; font-style: italic; line-height: 1.5;
      color: var(--cream); margin-bottom: 40px;
    }
    .manifesto-quote em { color: var(--gold-light); font-style: normal; }
    .manifesto-attr {
      font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--stone);
    }

    /* ── Capabilities (editorial) ── */
    .capabilities { padding: 140px 56px; }
    .caps-inner { max-width: 1100px; margin: 0 auto; }
    .caps-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 80px; border-bottom: 1px solid var(--border-soft); padding-bottom: 32px; }
    .caps-label { font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold); }
    .caps-title { font-family: var(--ff-serif); font-size: clamp(36px, 5vw, 60px); font-weight: 300; }
    .caps-count { font-family: var(--ff-serif); font-size: 80px; font-weight: 300; color: rgba(201,168,76,0.15); line-height: 1; }
    .caps-list { display: grid; gap: 0; }
    .cap-row {
      display: grid; grid-template-columns: 80px 1fr 1fr auto;
      align-items: center; gap: 40px;
      padding: 28px 0; border-bottom: 1px solid var(--border-soft);
      transition: background 0.3s;
    }
    .cap-row:hover { background: rgba(201,168,76,0.02); }
    .cap-num { font-family: var(--ff-serif); font-size: 13px; color: var(--stone); font-weight: 300; }
    .cap-name { font-family: var(--ff-serif); font-size: 20px; font-weight: 400; color: var(--cream); }
    .cap-desc { font-size: 13px; color: var(--stone-light); line-height: 1.7; letter-spacing: 0.03em; }
    .cap-cat {
      font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--gold); border: 1px solid var(--border); padding: 4px 12px;
      white-space: nowrap;
    }

    /* ── Provenance / specs ── */
    .provenance {
      padding: 140px 56px;
      background: var(--ink-2);
      border-top: 1px solid var(--border-soft);
    }
    .prov-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
    .prov-text-label { font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold); margin-bottom: 24px; }
    .prov-title { font-family: var(--ff-serif); font-size: clamp(36px, 4vw, 54px); font-weight: 300; line-height: 1.2; margin-bottom: 32px; }
    .prov-title em { font-style: italic; color: var(--gold-light); }
    .prov-body { font-size: 14px; color: var(--stone-light); line-height: 2; letter-spacing: 0.04em; }
    .prov-specs { display: flex; flex-direction: column; gap: 0; }
    .prov-spec {
      display: flex; align-items: baseline; justify-content: space-between;
      padding: 20px 0; border-bottom: 1px solid var(--border-soft);
    }
    .prov-spec-name { font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--stone); }
    .prov-spec-val { font-family: var(--ff-serif); font-size: 18px; color: var(--cream); font-weight: 400; }

    /* ── Collections (products) ── */
    #collections { padding: 140px 56px; }
    .coll-inner { max-width: 1100px; margin: 0 auto; }
    .coll-header { text-align: center; margin-bottom: 80px; }
    .coll-label { font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold); margin-bottom: 20px; display: block; }
    .coll-title { font-family: var(--ff-serif); font-size: clamp(40px, 6vw, 72px); font-weight: 300; color: var(--cream); }
    .coll-sub { font-size: 13px; color: var(--stone-light); margin-top: 16px; letter-spacing: 0.08em; line-height: 1.8; }
    .coll-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
    .coll-card { position: relative; background: var(--ink-2); overflow: hidden; }
    .coll-card-inner { padding: 56px 48px; position: relative; }
    .coll-card::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(201,168,76,0.06) 0%, transparent 70%);
      opacity: 0; transition: opacity 0.4s;
    }
    .coll-card:hover::before { opacity: 1; }
    .coll-card-edition {
      font-size: 9px; letter-spacing: 0.35em; text-transform: uppercase;
      color: var(--gold); margin-bottom: 32px; display: block;
    }
    .coll-card-ring {
      width: 140px; height: 140px; border-radius: 50%; margin: 0 auto 40px;
      display: flex; align-items: center; justify-content: center;
      transition: transform 0.5s ease;
    }
    .coll-card:hover .coll-card-ring { transform: scale(1.04) rotate(5deg); }
    .coll-ring-exec {
      border: 18px solid #8B7355;
      box-shadow: 0 0 0 1px rgba(139,115,85,0.3), 0 0 30px rgba(139,115,85,0.2), inset 0 1px 3px rgba(255,255,255,0.15);
    }
    .coll-ring-pres {
      border: 18px solid var(--gold);
      box-shadow: 0 0 0 1px rgba(201,168,76,0.4), 0 0 40px rgba(201,168,76,0.25), inset 0 1px 3px rgba(255,255,255,0.2);
    }
    .coll-card-name { font-family: var(--ff-serif); font-size: 36px; font-weight: 400; margin-bottom: 8px; color: var(--cream); }
    .coll-card-tagline { font-size: 13px; color: var(--stone-light); letter-spacing: 0.06em; line-height: 1.7; margin-bottom: 32px; }
    .coll-card-price { font-family: var(--ff-serif); font-size: 28px; font-weight: 300; margin-bottom: 8px; }
    .coll-card-price-note { font-size: 11px; color: var(--stone); letter-spacing: 0.1em; margin-bottom: 40px; }
    .coll-features { list-style: none; display: flex; flex-direction: column; gap: 12px; margin-bottom: 48px; }
    .coll-features li {
      font-size: 12px; letter-spacing: 0.08em; color: var(--stone-light);
      display: flex; align-items: center; gap: 12px;
    }
    .coll-features li::before { content: '—'; color: var(--gold); flex-shrink: 0; }
    .coll-featured-badge {
      position: absolute; top: 24px; right: 24px;
      font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--ink); background: var(--gold); padding: 6px 14px;
    }
    .btn-acquire {
      display: inline-block; width: 100%; text-align: center;
      padding: 18px 40px; border: 1px solid;
      font-size: 11px; font-weight: 400; letter-spacing: 0.25em; text-transform: uppercase;
      transition: all 0.3s;
    }
    .btn-acquire-exec {
      border-color: rgba(139,115,85,0.4); color: var(--stone-light);
    }
    .btn-acquire-exec:hover { background: #8B7355; border-color: #8B7355; color: var(--ink); }
    .btn-acquire-pres {
      border-color: var(--border); color: var(--gold);
      background: rgba(201,168,76,0.06);
    }
    .btn-acquire-pres:hover { background: var(--gold); border-color: var(--gold); color: var(--ink); }
    .coll-secure {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      margin-top: 14px; font-size: 10px; letter-spacing: 0.15em;
      color: var(--stone); text-transform: uppercase;
    }

    /* ── Testimonials ── */
    .testimony { padding: 140px 56px; background: var(--ink-2); border-top: 1px solid var(--border-soft); }
    .test-inner { max-width: 1100px; margin: 0 auto; }
    .test-header { text-align: center; margin-bottom: 80px; }
    .test-label { font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold); margin-bottom: 16px; display: block; }
    .test-title { font-family: var(--ff-serif); font-size: clamp(36px, 4vw, 54px); font-weight: 300; font-style: italic; }
    .test-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 40px; }
    .test-card { padding: 40px 0; border-top: 1px solid var(--border); }
    .test-stars { display: flex; gap: 4px; margin-bottom: 24px; }
    .test-stars svg { width: 12px; height: 12px; fill: var(--gold); }
    .test-quote {
      font-family: var(--ff-serif); font-size: 18px; font-weight: 300;
      font-style: italic; line-height: 1.8; color: var(--cream);
      margin-bottom: 28px;
    }
    .test-attr { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--stone); }
    .test-attr strong { color: var(--stone-light); display: block; margin-bottom: 4px; }

    /* ── FAQ ── */
    .faq-section { padding: 140px 56px; }
    .faq-inner { max-width: 760px; margin: 0 auto; }
    .faq-header { text-align: center; margin-bottom: 80px; }
    .faq-label { font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold); margin-bottom: 16px; display: block; }
    .faq-title { font-family: var(--ff-serif); font-size: clamp(36px, 4vw, 54px); font-weight: 300; }
    .faq-list { display: flex; flex-direction: column; gap: 0; }
    .faq-item { border-bottom: 1px solid var(--border-soft); }
    .faq-q {
      width: 100%; display: flex; justify-content: space-between; align-items: center;
      padding: 28px 0; background: none; border: none; cursor: none;
      font-family: var(--ff-sans); font-size: 14px; font-weight: 300;
      letter-spacing: 0.06em; color: var(--cream); text-align: left; gap: 20px;
    }
    .faq-q-icon { font-size: 20px; color: var(--gold); flex-shrink: 0; line-height: 1; transition: transform 0.3s; }
    .faq-q.open .faq-q-icon { transform: rotate(45deg); }
    .faq-a { max-height: 0; overflow: hidden; transition: max-height 0.4s ease, padding 0.3s; }
    .faq-a.open { max-height: 200px; padding-bottom: 28px; }
    .faq-a p { font-size: 13px; color: var(--stone-light); line-height: 2; letter-spacing: 0.04em; }

    /* ── Final CTA ── */
    .finale {
      padding: 180px 56px;
      text-align: center;
      background:
        radial-gradient(ellipse 60% 60% at 50% 50%, rgba(201,168,76,0.06) 0%, transparent 70%);
      border-top: 1px solid var(--border-soft);
    }
    .finale-label { font-size: 10px; letter-spacing: 0.4em; text-transform: uppercase; color: var(--gold); margin-bottom: 32px; display: block; }
    .finale-title { font-family: var(--ff-serif); font-size: clamp(48px, 8vw, 100px); font-weight: 300; line-height: 1.0; letter-spacing: -0.01em; margin-bottom: 24px; }
    .finale-title em { font-style: italic; color: var(--gold-light); }
    .finale-sub { font-size: 13px; color: var(--stone-light); letter-spacing: 0.1em; line-height: 2; margin-bottom: 56px; }
    .finale-ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

    /* ── Footer ── */
    footer {
      background: var(--ink); border-top: 1px solid var(--border-soft);
